ORACLE_PASSWORD=change-oracle-admin-password
ORACLE_APP_USER=template_user
ORACLE_APP_PASSWORD=change-application-password
ORACLE_PORT=1521
SERVER_PORT=8080

# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional one-time administrator bootstrap
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=Administrator
